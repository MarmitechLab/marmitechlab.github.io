---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedProjects } from '../../lib/projects';

const published = await getPublishedProjects();
const techCounts = new Map<string, number>();
for (const p of published) {
	for (const tech of p.data.technologies) {
		techCounts.set(tech, (techCounts.get(tech) ?? 0) + 1);
	}
}
const techs = [...techCounts.entries()].sort(
	(a, b) => b[1] - a[1] || a[0].localeCompare(b[0])
);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Tecnologias — Catálogo Marmitech" description="Tecnologias usadas nos projetos.">
	<section class="mx-auto max-w-6xl px-6 py-12">
		<h1 class="text-3xl font-bold tracking-tight">Tecnologias</h1>
		<p class="mt-2 text-neutral-600">
			Todas as tecnologias encontradas nos projetos publicados.
		</p>
		<ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
			{techs.map(([tech, count]) => (
				<li>
					<a
						href={`${base}tecnologias/${encodeURIComponent(tech)}/`}
						class="flex items-center justify-between rounded-xl border border-line bg-white px-4 py-3 transition hover:border-marmitech-jr"
					>
						<span class="font-medium text-ink">{tech}</span>
						<span class="text-xs text-neutral-500">
							{count} projeto{count === 1 ? '' : 's'}
						</span>
					</a>
				</li>
			))}
		</ul>
	</section>
</BaseLayout>