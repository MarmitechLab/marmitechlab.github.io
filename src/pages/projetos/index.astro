---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectFilters from '../../components/ProjectFilters.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getPublishedProjects } from '../../lib/projects';

const projects = await getPublishedProjects();
---
<BaseLayout
	title="Explorar projetos — Catálogo Marmitech"
	description="Explore e filtre os projetos do Marmitech e Marmitech Jr."
>
	<section class="mx-auto max-w-6xl px-6 py-12">
		<h1 class="text-3xl font-bold tracking-tight">Explorar projetos</h1>
		<p class="mt-2 text-neutral-600">Filtre por categoria, programa, ano ou palavra-chave.</p>

		<div class="mt-8">
			<ProjectFilters projects={projects} />
			<ProjectGrid projects={projects} />
		</div>
	</section>
</BaseLayout>