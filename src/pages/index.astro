---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stats from '../components/Stats.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import ProgramBadge from '../components/ProgramBadge.astro';
import { getPublishedProjects, getFeaturedProjects, byProgram } from '../lib/projects';

const base = import.meta.env.BASE_URL;
const published = await getPublishedProjects();
const featured = await getFeaturedProjects();
const jr = byProgram(published, 'marmitech-jr');
---
<BaseLayout
	title="Catálogo Marmitech"
	description="Catálogo dos projetos estudantis do Marmitech (Ensino Médio Técnico) e Marmitech Jr. (9º ano do Ensino Fundamental)."
>
	<!-- Hero -->
	<section class="mx-auto max-w-6xl px-6 pt-16 pb-12">
		<div class="max-w-3xl">
			<p class="flex items-center gap-2 text-sm font-medium text-neutral-500">
				<span class="inline-flex h-1.5 w-1.5 rounded-full bg-marmitech-jr"></span>
				Marmitech · Educação Tecnológica Voluntária
			</p>
			<h1 class="mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
				Projetos feitos por estudantes,
				<br />
				<span class="text-marmitech-jr">para o mundo ver.</span>
			</h1>
			<p class="mt-4 max-w-xl text-lg text-neutral-600">
				Jogos, apps, sites e projetos de IA criados pelo Marmitech (Ensino Médio Técnico) e
				Marmitech Jr. (9º ano do Ensino Fundamental).
			</p>
			<div class="mt-6 flex flex-wrap gap-3">
				<a
					href={`${base}projetos/`}
					class="rounded-md bg-ink px-5 py-2.5 font-medium text-paper transition hover:bg-neutral-800"
				>
					Explorar projetos
				</a>
				<a
					href={`${base}sobre/`}
					class="rounded-md border border-line px-5 py-2.5 font-medium transition hover:bg-black/5"
				>
					Sobre o programa
				</a>
			</div>
		</div>
	</section>

	<!-- Estatísticas -->
	<section class="mx-auto max-w-6xl px-6 pb-12">
		<Stats projects={published} />
	</section>

	<!-- Destaques -->
	<section class="mx-auto max-w-6xl px-6 pb-12">
		<div class="mb-6 flex items-center justify-between">
			<h2 class="text-2xl font-bold tracking-tight">Em destaque</h2>
			<a
				href={`${base}projetos/`}
				class="text-sm font-medium text-marmitech-jr hover:underline"
			>
				Ver todos →
			</a>
		</div>
		{featured.length > 0 ? (
			<ProjectGrid projects={featured} />
		) : (
			<p class="text-neutral-500">Nenhum projeto em destaque publicado ainda.</p>
		)}
	</section>

	<!-- Marmitech Jr. -->
	<section class="border-t border-line bg-white">
		<div class="mx-auto max-w-6xl px-6 py-12">
			<div class="mb-3 flex flex-wrap items-center gap-3">
				<h2 class="text-2xl font-bold tracking-tight">Marmitech Jr.</h2>
				<ProgramBadge program="marmitech-jr" />
			</div>
			<p class="mb-6 max-w-2xl text-neutral-600">
				Projetos do 9º ano do Ensino Fundamental — experimentação, criatividade, jogos e
				programação.
			</p>
			{jr.length > 0 ? (
				<ProjectGrid projects={jr} />
			) : (
				<p class="text-neutral-500">Nenhum projeto publicado do Marmitech Jr. ainda.</p>
			)}
		</div>
	</section>
</BaseLayout>
