---
import '../styles/global.css';
---

<!doctype html>
<html lang="pt-br">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			type="image/png"
			sizes="32x32"
			href={`${import.meta.env.BASE_URL}/favicon-32.png`}
		/>
		<link
			rel="icon"
			type="image/png"
			sizes="16x16"
			href={`${import.meta.env.BASE_URL}/favicon-16.png`}
		/>
		<link
			rel="apple-touch-icon"
			href={`${import.meta.env.BASE_URL}/apple-touch-icon.png`}
		/>
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Catálogo dos projetos estudantis do Marmitech (Ensino Médio Técnico) e Marmitech Jr. (9º ano do Ensino Fundamental) — jogos, apps, sites e projetos de IA."
		/>
		<title>Catálogo Marmitech</title>
	</head>
	<body>
		<header class="border-b border-line">
			<nav class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4">
				<a href={`${import.meta.env.BASE_URL}/`} class="flex items-center gap-3">
					<img
						src={`${import.meta.env.BASE_URL}/assets/logo/marmitech_logo.png`}
						alt="Logo Marmitech"
						width="40"
						height="40"
						class="h-10 w-10"
					/>
					<span class="text-lg font-semibold tracking-tight">
						Catálogo <span class="text-marmitech-jr">Marmitech</span>
					</span>
				</a>
				<span class="rounded-full border border-line px-3 py-1 text-xs font-medium text-neutral-500">
					Fase 1 · setup
				</span>
			</nav>
		</header>

		<main class="mx-auto max-w-5xl px-6 py-20">
			<h1 class="max-w-2xl text-4xl font-bold tracking-tight sm:text-5xl">
				Projetos feitos por estudantes,
				<br />
				<span class="text-marmitech-jr">para o mundo ver.</span>
			</h1>
			<p class="mt-4 max-w-xl text-lg text-neutral-600">
				O catálogo dos projetos do Marmitech e Marmitech Jr. — jogos, apps, sites e projetos de
				IA.
			</p>
			<div class="mt-10 flex flex-wrap gap-4 text-sm">
				<span class="rounded-md bg-ink px-4 py-2 font-medium text-paper">Estrutura pronta</span>
				<span class="rounded-md border border-line px-4 py-2 font-medium">Conteúdo na Fase 6</span>
			</div>
		</main>

		<footer class="border-t border-line py-6 text-center text-sm text-neutral-500">
			Marmitech · Ensino Médio Técnico &amp; Marmitech Jr. · 9º ano do Ensino Fundamental
		</footer>
	</body>
</html>
